---
import { getCollection } from "astro:content";
import BlogLayout from "../../../layouts/BlogLayout.astro";
import { slugifyTag } from "../../../lib/blog";
import { absoluteUrl } from "../../../lib/seo";

export async function getStaticPaths() {
  const posts = (await getCollection("blog")).filter(
    (post) => !post.data.draft,
  );
  const tagEntries = new Map<string, { tag: string; posts: typeof posts }>();

  for (const post of posts) {
    for (const tag of post.data.tags) {
      const slug = slugifyTag(tag);
      const entry = tagEntries.get(slug) ?? { tag, posts: [] };

      if (!entry.posts.some((entryPost) => entryPost.id === post.id)) {
        entry.posts.push(post);
      }

      tagEntries.set(slug, entry);
    }
  }

  return [...tagEntries.entries()].map(([tagSlug, entry]) => ({
    params: { tag: tagSlug },
    props: {
      tag: entry.tag,
      posts: entry.posts.sort(
        (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
      ),
    },
  }));
}

const { tag, posts } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat("en", {
    month: "short",
    day: "numeric",
    timeZone: "UTC",
    year: "numeric",
  }).format(date);

const structuredData = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": `${absoluteUrl(`blog/tags/${slugifyTag(tag)}/`)}#collection`,
  name: `Posts tagged ${tag}`,
  description: `Blog posts tagged ${tag} by Dylan Steele.`,
  url: absoluteUrl(`blog/tags/${slugifyTag(tag)}/`),
  inLanguage: "en-US",
  isPartOf: {
    "@id": `${absoluteUrl("blog/")}#blog`,
  },
  mainEntity: {
    "@type": "ItemList",
    itemListElement: posts.map((post, index) => ({
      "@type": "ListItem",
      position: index + 1,
      url: absoluteUrl(`blog/${post.id}/`),
      name: post.data.title,
    })),
  },
};
---

<BlogLayout
  title={`Posts tagged ${tag} - Dylan Steele`}
  description={`Blog posts tagged ${tag}.`}
  keywords={[tag, `Dylan Steele ${tag}`, `${tag} blog posts`]}
  structuredData={structuredData}
>
  <section class="blog-index" aria-labelledby="tag-title">
    <div class="blog-heading">
      <a class="back-link" href={`${base}blog/`}>All writing</a>
      <p class="section-kicker">Tag</p>
      <h1 id="tag-title">{tag}</h1>
    </div>

    <div class="post-list">
      {
        posts.map((post) => (
          <article class="post-card">
            <div class="post-card-meta">
              <time datetime={post.data.pubDate.toISOString()}>
                {formatDate(post.data.pubDate)}
              </time>
              <span>{post.data.type}</span>
            </div>
            <h2>
              <a href={`${base}blog/${post.id}/`}>{post.data.title}</a>
            </h2>
            <p>{post.data.description}</p>
          </article>
        ))
      }
    </div>
  </section>
</BlogLayout>
